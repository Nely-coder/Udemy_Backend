<!DOCTYPE html>
<html>

<head>
  <title>Taco Recipes</title>
  <link rel="stylesheet" type="text/css" href="/styles/main.css">
</head>

<body>
  <h1>Taco Town 🌮</h1>

  <form action="/recipe" method="POST" class="buttons">
    <button type="submit" value="chicken" name="choice">🍗</button>
    <button type="submit" value="beef" name="choice">🥩</button>
    <button type="submit" value="fish" name="choice">🐟</button>
  </form>
  <div id="recipeContainer" class="hidden">

    <!-- If no recipe yet, show: -->
     <% if (locals.proteinChoice) { %>
      <h2> <%= proteinChoice %> Taco</h2>
     <% } else {  %>
      <h2>Pick your favourite taco ingredient 👆</h2>
     <% } %>
    
    <!-- Else, show the recipe name e.g. <h2>Recipe name</h2>-->

    <h3>Ingredients:</h3>

    <% if (locals.recipe && locals.proteinChoice) { %>

      <% for (let i = 0; i < recipe.length; i++) { %>

        <% if (recipe[i].ingredients.protein.name.toLowerCase() === proteinChoice) { %>

          <ul id="ingredientsList">
          <li><%= recipe[i].ingredients.protein.name %>, <%= recipe[i].ingredients.protein.preparation %></li>
          <li><%= recipe[i].ingredients.salsa.name %></li>

          <% for (let j = 0; j < recipe[i].ingredients.toppings.length; j++) { %>
            <% const toppings = recipe[i].ingredients.toppings; %>
            <li><%= toppings[j].quantity %> of <%= toppings[j].name %></li>
          <% } %>
          
        </ul>

        <% } %>
        

      <% } %>
      

    <% } %>

    



  </div>
</body>

</html>